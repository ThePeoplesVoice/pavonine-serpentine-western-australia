<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PAVONINE — Rare Feather Atelier • Serpentine Perth WA</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Cinzel:wght@400;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
  --bg:       #0a0906;
  --surface:  #111009;
  --border:   rgba(180,145,60,0.18);
  --gold:     #c9a84c;
  --gold-lt:  #e2c77a;
  --teal:     #4abdb5;
  --teal-dk:  #2e8f88;
  --muted:    #7a7060;
  --text:     #e8e0d0;
  --text-dim: #a89f8c;
  --white:    #f5f0e8;
  --modal-bg: rgba(6,5,4,0.92);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: 'Jost', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
  cursor: default;
}

/* ─── GRAIN OVERLAY ─── */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 1000;
  opacity: 0.4;
}

/* ─── NAV ─── */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 900;
  padding: 22px 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(180deg, rgba(10,9,6,0.95) 0%, transparent 100%);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border);
}

.nav-logo {
  font-family: 'Cinzel', serif;
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: 0.22em;
  color: var(--gold);
  text-decoration: none;
}

.nav-logo span {
  font-weight: 400;
  color: var(--text-dim);
  font-size: 0.75rem;
  letter-spacing: 0.15em;
  display: block;
  margin-top: 2px;
}

.nav-links {
  display: flex;
  gap: 36px;
  list-style: none;
}

.nav-links a {
  font-size: 0.78rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--text-dim);
  text-decoration: none;
  transition: color 0.25s;
}

.nav-links a:hover { color: var(--gold-lt); }

/* ─── HERO ─── */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  padding: 120px 48px 80px;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 70% 60% at 60% 40%, rgba(74,189,181,0.07) 0%, transparent 70%),
    radial-gradient(ellipse 50% 50% at 20% 70%, rgba(201,168,76,0.08) 0%, transparent 60%),
    radial-gradient(ellipse 80% 80% at 50% 50%, rgba(0,0,0,0.5) 0%, transparent 100%);
}

.hero-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(135deg, transparent 49.5%, rgba(201,168,76,0.04) 49.5%, rgba(201,168,76,0.04) 50.5%, transparent 50.5%),
    linear-gradient(45deg, transparent 49.5%, rgba(74,189,181,0.03) 49.5%, rgba(74,189,181,0.03) 50.5%, transparent 50.5%);
  background-size: 80px 80px;
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 780px;
}

.hero-eyebrow {
  font-size: 0.72rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--teal);
  margin-bottom: 28px;
  opacity: 0;
  animation: fadeUp 0.9s 0.2s forwards;
}

.hero h1 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(3.2rem, 8vw, 7rem);
  font-weight: 300;
  line-height: 1.0;
  color: var(--white);
  letter-spacing: -0.01em;
  opacity: 0;
  animation: fadeUp 1.1s 0.4s forwards;
}

.hero h1 em {
  font-style: italic;
  color: var(--gold);
}

.hero-sub {
  margin-top: 28px;
  font-size: 1.05rem;
  font-weight: 300;
  color: var(--text-dim);
  line-height: 1.75;
  max-width: 520px;
  margin-left: auto;
  margin-right: auto;
  opacity: 0;
  animation: fadeUp 1.1s 0.65s forwards;
}

.hero-cta {
  margin-top: 48px;
  display: flex;
  gap: 20px;
  justify-content: center;
  flex-wrap: wrap;
  opacity: 0;
  animation: fadeUp 1.1s 0.85s forwards;
}

.btn-primary {
  padding: 14px 36px;
  background: transparent;
  border: 1px solid var(--gold);
  color: var(--gold);
  font-family: 'Jost', sans-serif;
  font-size: 0.8rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.3s;
  text-decoration: none;
  display: inline-block;
}

.btn-primary:hover {
  background: var(--gold);
  color: var(--bg);
}

.btn-ghost {
  padding: 14px 36px;
  background: transparent;
  border: 1px solid rgba(255,255,255,0.12);
  color: var(--text-dim);
  font-family: 'Jost', sans-serif;
  font-size: 0.8rem;
  font-weight: 400;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.3s;
  text-decoration: none;
  display: inline-block;
}

.btn-ghost:hover {
  border-color: var(--text-dim);
  color: var(--text);
}

.scroll-hint {
  position: absolute;
  bottom: 36px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  opacity: 0;
  animation: fadeUp 1s 1.4s forwards;
}

.scroll-hint span {
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--muted);
}

.scroll-line {
  width: 1px;
  height: 44px;
  background: linear-gradient(180deg, var(--gold) 0%, transparent 100%);
  animation: scrollPulse 2s 2s infinite;
}

/* ─── MARQUEE ─── */
.marquee-wrap {
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 14px 0;
  overflow: hidden;
  background: rgba(201,168,76,0.03);
}

.marquee-track {
  display: flex;
  gap: 0;
  animation: marquee 28s linear infinite;
  white-space: nowrap;
}

.marquee-track span {
  font-size: 0.68rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--muted);
  padding: 0 40px;
}

.marquee-track span.accent { color: var(--gold); }

/* ─── SECTION SHARED ─── */
section {
  padding: 110px 48px;
}

.section-eyebrow {
  font-size: 0.68rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--teal);
  margin-bottom: 18px;
}

.section-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2.2rem, 4vw, 3.4rem);
  font-weight: 300;
  line-height: 1.15;
  color: var(--white);
}

.section-title em { font-style: italic; color: var(--gold); }

/* ─── ABOUT ─── */
.about {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
  max-width: 1200px;
  margin: 0 auto;
}

.about-visual {
  position: relative;
  aspect-ratio: 4/5;
  border: 1px solid var(--border);
  overflow: hidden;
}

.about-visual-inner {
  width: 100%;
  height: 100%;
  background:
    radial-gradient(ellipse 80% 80% at 40% 30%, rgba(74,189,181,0.15) 0%, transparent 60%),
    radial-gradient(ellipse 60% 60% at 70% 70%, rgba(201,168,76,0.12) 0%, transparent 50%),
    linear-gradient(135deg, #0f0e0b 0%, #161410 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.feather-svg {
  width: 60%;
  opacity: 0.35;
}

.about-corner {
  position: absolute;
  bottom: 24px;
  right: 24px;
  padding: 12px 18px;
  background: rgba(10,9,6,0.85);
  border: 1px solid var(--border);
  font-size: 0.7rem;
  letter-spacing: 0.15em;
  color: var(--gold);
  text-transform: uppercase;
}

.about-text p {
  font-size: 1.0rem;
  font-weight: 300;
  color: var(--text-dim);
  line-height: 1.9;
  margin-top: 28px;
}

.about-text p + p { margin-top: 18px; }

.about-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-top: 44px;
  border-top: 1px solid var(--border);
  padding-top: 36px;
}

.stat-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 2.4rem;
  font-weight: 300;
  color: var(--gold);
  line-height: 1;
}

.stat-label {
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
  margin-top: 6px;
}

/* ─── COLLECTION GRID ─── */
.collection-section {
  background: var(--surface);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.collection-section .inner {
  max-width: 1200px;
  margin: 0 auto;
}

.collection-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 56px;
}

.collection-note {
  font-size: 0.82rem;
  color: var(--muted);
  max-width: 260px;
  text-align: right;
  line-height: 1.6;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.card {
  border: 1px solid var(--border);
  overflow: hidden;
  transition: border-color 0.35s, transform 0.35s;
  cursor: pointer;
  background: var(--bg);
  position: relative;
}

.card:hover {
  border-color: rgba(201,168,76,0.45);
  transform: translateY(-4px);
}

.card-img {
  aspect-ratio: 3/4;
  position: relative;
  overflow: hidden;
}

.card-img-inner {
  width: 100%;
  height: 100%;
  transition: transform 0.6s ease;
}

.card:hover .card-img-inner {
  transform: scale(1.04);
}

.card:nth-child(1) .card-img-inner {
  background:
    radial-gradient(ellipse 70% 90% at 35% 25%, rgba(74,189,181,0.22) 0%, transparent 65%),
    radial-gradient(ellipse 50% 60% at 75% 75%, rgba(201,168,76,0.18) 0%, transparent 60%),
    linear-gradient(160deg, #0d1614 0%, #090a08 100%);
}
.card:nth-child(2) .card-img-inner {
  background:
    radial-gradient(ellipse 60% 80% at 65% 30%, rgba(201,168,76,0.25) 0%, transparent 65%),
    radial-gradient(ellipse 40% 50% at 25% 80%, rgba(74,189,181,0.12) 0%, transparent 60%),
    linear-gradient(160deg, #140f06 0%, #090808 100%);
}
.card:nth-child(3) .card-img-inner {
  background:
    radial-gradient(ellipse 80% 70% at 50% 40%, rgba(120,80,180,0.15) 0%, transparent 65%),
    radial-gradient(ellipse 50% 60% at 30% 70%, rgba(201,168,76,0.2) 0%, transparent 60%),
    linear-gradient(160deg, #0e0b14 0%, #090808 100%);
}
.card:nth-child(4) .card-img-inner {
  background:
    radial-gradient(ellipse 70% 80% at 40% 60%, rgba(74,189,181,0.18) 0%, transparent 65%),
    radial-gradient(ellipse 50% 40% at 70% 20%, rgba(201,168,76,0.14) 0%, transparent 60%),
    linear-gradient(160deg, #0b1413 0%, #090a09 100%);
}
.card:nth-child(5) .card-img-inner {
  background:
    radial-gradient(ellipse 60% 70% at 60% 35%, rgba(220,120,60,0.12) 0%, transparent 65%),
    radial-gradient(ellipse 50% 60% at 30% 75%, rgba(74,189,181,0.16) 0%, transparent 60%),
    linear-gradient(160deg, #130e09 0%, #090808 100%);
}
.card:nth-child(6) .card-img-inner {
  background:
    radial-gradient(ellipse 80% 60% at 50% 50%, rgba(201,168,76,0.2) 0%, transparent 65%),
    radial-gradient(ellipse 40% 50% at 20% 30%, rgba(74,189,181,0.1) 0%, transparent 60%),
    linear-gradient(160deg, #12100a 0%, #090808 100%);
}

.card-feather {
  position: absolute;
  bottom: 10%;
  left: 50%;
  transform: translateX(-50%);
  font-size: 5rem;
  opacity: 0.12;
  filter: blur(1px);
  user-select: none;
}

.card-badge {
  position: absolute;
  top: 16px;
  right: 16px;
  background: rgba(10,9,6,0.88);
  border: 1px solid var(--border);
  padding: 5px 12px;
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold);
}

.card-body {
  padding: 22px 24px 24px;
  border-top: 1px solid var(--border);
}

.card-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.25rem;
  font-weight: 400;
  color: var(--white);
  line-height: 1.3;
}

.card-meta {
  font-size: 0.72rem;
  letter-spacing: 0.15em;
  color: var(--muted);
  text-transform: uppercase;
  margin-top: 5px;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18px;
}

.card-price {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.35rem;
  color: var(--gold);
  font-weight: 300;
}

.card-price small {
  font-size: 0.72rem;
  color: var(--muted);
  font-family: 'Jost', sans-serif;
  letter-spacing: 0.1em;
  display: block;
  font-weight: 400;
  margin-top: 1px;
}

.reserve-btn {
  padding: 9px 18px;
  border: 1px solid var(--gold);
  background: transparent;
  color: var(--gold);
  font-family: 'Jost', sans-serif;
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.25s;
}

.reserve-btn:hover {
  background: var(--gold);
  color: var(--bg);
}

/* ─── PROCESS ─── */
.process-section .inner {
  max-width: 1000px;
  margin: 0 auto;
  text-align: center;
}

.process-steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  margin-top: 60px;
}

.step {
  background: var(--bg);
  padding: 44px 28px;
  position: relative;
}

.step-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 3rem;
  color: rgba(201,168,76,0.15);
  font-weight: 300;
  line-height: 1;
  position: absolute;
  top: 20px;
  right: 20px;
}

.step-icon {
  font-size: 1.8rem;
  margin-bottom: 18px;
}

.step h3 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.15rem;
  font-weight: 400;
  color: var(--white);
  margin-bottom: 10px;
}

.step p {
  font-size: 0.82rem;
  color: var(--muted);
  line-height: 1.7;
  font-weight: 300;
}

/* ─── TESTIMONIALS ─── */
.testimonials-section {
  background: var(--surface);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.testimonials-section .inner {
  max-width: 1100px;
  margin: 0 auto;
}

.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 56px;
}

.testimonial {
  border: 1px solid var(--border);
  padding: 32px;
  position: relative;
}

.testimonial::before {
  content: '"';
  font-family: 'Cormorant Garamond', serif;
  font-size: 5rem;
  color: rgba(201,168,76,0.12);
  position: absolute;
  top: 8px;
  left: 24px;
  line-height: 1;
}

.testimonial-text {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.1rem;
  font-style: italic;
  color: var(--text);
  line-height: 1.75;
  margin-top: 24px;
}

.testimonial-author {
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px solid var(--border);
  font-size: 0.7rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
}

.testimonial-author strong {
  display: block;
  color: var(--gold);
  margin-bottom: 3px;
}

/* ─── FOOTER ─── */
footer {
  padding: 60px 48px 40px;
  border-top: 1px solid var(--border);
}

.footer-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr;
  gap: 60px;
}

.footer-brand .logo {
  font-family: 'Cinzel', serif;
  font-size: 1rem;
  color: var(--gold);
  letter-spacing: 0.22em;
}

.footer-brand p {
  font-size: 0.82rem;
  color: var(--muted);
  line-height: 1.8;
  margin-top: 16px;
  max-width: 260px;
  font-weight: 300;
}

.footer-col h4 {
  font-size: 0.68rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 20px;
}

.footer-col a {
  display: block;
  font-size: 0.82rem;
  color: var(--muted);
  text-decoration: none;
  margin-bottom: 10px;
  transition: color 0.2s;
  font-weight: 300;
}

.footer-col a:hover { color: var(--text); }

.footer-bottom {
  max-width: 1200px;
  margin: 40px auto 0;
  padding-top: 24px;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-bottom p {
  font-size: 0.72rem;
  color: var(--muted);
  letter-spacing: 0.08em;
}

/* ─── MODAL ─── */
.modal-bg {
  position: fixed;
  inset: 0;
  background: var(--modal-bg);
  z-index: 9000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s;
  backdrop-filter: blur(12px);
}

.modal-bg.active {
  opacity: 1;
  pointer-events: all;
}

.modal {
  background: #0e0d0a;
  border: 1px solid var(--border);
  max-width: 640px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 44px 44px 40px;
  position: relative;
  box-shadow: 0 40px 120px rgba(0,0,0,0.8);
  animation: none;
}

.modal-bg.active .modal {
  animation: modalIn 0.4s cubic-bezier(0.16,1,0.3,1) forwards;
}

.modal-close {
  position: absolute;
  top: 18px;
  right: 18px;
  background: transparent;
  border: 1px solid var(--border);
  color: var(--muted);
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  padding: 7px 14px;
  cursor: pointer;
  transition: all 0.2s;
  font-family: 'Jost', sans-serif;
}

.modal-close:hover {
  border-color: var(--gold);
  color: var(--gold);
}

.modal-eyebrow {
  font-size: 0.65rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--teal);
  margin-bottom: 10px;
}

.modal-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 2.1rem;
  font-weight: 300;
  color: var(--white);
  line-height: 1.2;
  margin-bottom: 10px;
}

.modal-title em { font-style: italic; color: var(--gold); }

.modal-sub {
  font-size: 0.88rem;
  color: var(--text-dim);
  line-height: 1.7;
  font-weight: 300;
}

hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: 24px 0;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-bottom: 14px;
}

.form-row.full { grid-template-columns: 1fr; }

.form-row input,
.form-row select,
.form-row textarea {
  width: 100%;
  padding: 12px 16px;
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--border);
  color: var(--text);
  font-family: 'Jost', sans-serif;
  font-size: 0.88rem;
  font-weight: 300;
  outline: none;
  transition: border-color 0.25s;
  resize: none;
  appearance: none;
}

.form-row input::placeholder { color: var(--muted); }

.form-row input:focus,
.form-row select:focus {
  border-color: rgba(201,168,76,0.5);
}

.form-row input[readonly] {
  color: var(--gold);
  font-size: 1.2rem;
  font-family: 'Cormorant Garamond', serif;
}

.method-grid {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
